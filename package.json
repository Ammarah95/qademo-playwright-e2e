{
  "name": "qademo-playwright-e2e",
  "version": "1.0.0",
  "description": "End-to-end UI + API test automation for the QA Demo e-commerce store (qademo.com) using Playwright, JavaScript and the Page Object Model.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report reports/html",
    "allure:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "allure:open": "allure open reports/allure-report",
    "dashboard": "node scripts/generate-dashboard.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": ["playwright", "e2e", "page-object-model", "qa", "test-automation", "ci-cd"],
  "author": "Ammarah Ayubi",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-plugin-playwright": "^2.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
